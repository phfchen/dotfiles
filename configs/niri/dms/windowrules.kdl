// DMS Window Rules - Managed by DankMaterialShell
// Do not edit manually - changes may be overwritten

// @id=dms_rule_0 @name=
window-rule {
    match app-id="(?i)^spotify$"
    match app-id="(?i)^vlc$"
    open-maximized true
}

// @id=dms_rule_1 @name=
window-rule {
    match app-id="(?i)^spotify$"
    match app-id="(?i)^vlc$"
    open-on-workspace "Media"
}

// @id=dms_rule_2 @name=
window-rule {
    match app-id="(?i)^signal$"
    match app-id="(?i)^brave-ophjlpahpchlmihnnnihgmmeilfjmjjc-Default$"
    match app-id="(?i)^org.mozilla.Thunderbird$"
    match title="(?i)^WhatsApp - Brave$"
    open-on-workspace "Communication"
}

// @id=dms_rule_3 @name=
window-rule {
    match app-id="^brave-nngceckbapebfimnlniiiahkandclblb-Default$"
    match app-id="(?i)^thunar$" title="^Rename"
    match app-id="(?i)^thunar$" title="^File Operation Progress"
    open-floating true
}

// @id=dms-floating-windows @name=DMS Floating Windows
window-rule {
    match app-id="^com.danklinux.dms$"
    open-floating true
}
